# Generated by Terraform. Do not edit in place.
#
# 段ごとの allowlist を送信元 IP (= subnet) で出し分ける。
# proxy が識別できるのは送信元 IP だけなので、allowlist を分けたい粒度で
# subnet が分かれている必要がある。この対応が「subnet が権限の単位」の実体。

http_port ${listen_port}

# キャッシュも pid も持たない。この proxy は経路の装置であって蓄積装置ではない。
pid_filename none
cache deny all
access_log stdio:/dev/stdout combined
cache_log stdio:/dev/stderr
httpd_suppress_version_string on

# 内部トポロジを origin に漏らさない。
forwarded_for delete
via off
request_header_access X-Forwarded-For deny all

# app 側の IP pin が使えなくなった (httpcore がトンネルで sni_hostname を無視する)
# ため、Squid の名前解決が本番経路になった。VPC は v4-only で AAAA が引けても
# 経路が無い。
#
# かつての `dns_v4_first on` は **Squid 6 で廃止**されており (6.12 で
# "Directive is obsolete" のエラーになる)、代わりに Happy Eyeballs (RFC 8305) が
# 両アドレスファミリを並行して試す。IPv6 側は即座に失敗して IPv4 に倒れるので、
# 既定のままで正しく動く。待ち時間は下の値が上限。
happy_eyeballs_connect_timeout 250

# `via off` は「HTTP requires the use of Via」という警告を出すが意図どおり。
# proxy の存在自体を origin に知らせない。

# 既定の 30 秒だと SIGTERM 後に粘り、ECS の stopTimeout (既定 30 秒) と競合して
# SIGKILL で終わる。入れ替えを速く綺麗にする。
shutdown_lifetime 5 seconds

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

# app/shared/security/ssrf_guard.py の PublicIpAddress と同じ集合の写し。
# **SSoT が 2 箇所になる。** 変更時は必ず両方を見る (テストで一致を固定する)。
acl to_private dst ${join(" ", private_v4_ranges)}
acl to_private dst ${join(" ", private_v6_ranges)}

# 評価は上から順。まず形と宛先で落とし、そのあと段ごとに許す。
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny to_private

# Squid 自身の管理インターフェース。既定の squid.conf が必ず持つ防御で、
# スクラッチで組むと落ちる。**fetch は宛先無制限なので、これが無いと
# http://<任意の public ホスト>/squid-internal-mgr/... で設定ダンプに届く**
# (宛先が public なので to_private を抜け、fetch の allow に落ちる)。
# manager は組み込み ACL なので宣言は要らない。
http_access deny manager

%{ for name, client in clients ~}
# --- ${name} ---
acl src_${name} src ${client.cidr}
%{ if length(client.domains) > 0 ~}
acl dst_${name} dstdomain ${join(" ", client.domains)}
http_access allow src_${name} dst_${name}
%{ endif ~}
%{ if client.unrestricted ~}
# 宛先を絞らない。出先が news_sources テーブル駆動で可変なため、静的な
# allowlist を書けない。到達可能な範囲は上の to_private deny だけが決める。
http_access allow src_${name}
%{ endif ~}

%{ endfor ~}
http_access deny all
